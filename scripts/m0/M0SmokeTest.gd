extends SceneTree

const M0CombatSimulationScript = preload("res://scripts/m0/M0CombatSimulation.gd")
const M0AutoplayRunnerScript = preload("res://scripts/m0/M0AutoplayRunner.gd")
const M0DebugLogScript = preload("res://scripts/m0/M0DebugLog.gd")

var failed = false


func _init() -> void:
	var simulation = M0CombatSimulationScript.new()
	_assert(simulation.load_data(), "m0_test_data.json loads")

	if failed:
		quit(1)
		return

	var debug_log = M0DebugLogScript.new()
	debug_log.push("Walker spawned at east.")
	debug_log.push("Reward claimed: Arc Spark.")
	debug_log.push("Run started: Guardian.")
	debug_log.push("Card rejected: no target.")
	_assert(debug_log.to_text_filtered("combat").contains("Walker spawned"), "debug log filters combat entries")
	_assert(not debug_log.to_text_filtered("reward").contains("Walker spawned"), "debug log hides unrelated categories")
	_assert(debug_log.to_text_filtered("reward").contains("[Reward] Reward claimed"), "debug log labels reward entries")
	_assert(debug_log.to_text_filtered("all", true).contains("Card rejected"), "debug log important filter keeps rejected actions")
	_assert(not debug_log.to_text_filtered("all", true).contains("Run started"), "debug log important filter hides routine setup")

	_assert(simulation.get_active_directions(1) == ["east"], "solo uses east only")
	_assert(simulation.get_active_directions(2) == ["north", "east"], "2p uses north/east")
	_assert(simulation.get_active_directions(3) == ["west", "north", "east"], "3p uses west/north/east")
	_assert(simulation.get_active_directions(4) == ["west", "north", "east", "south"], "4p uses all directions")
	_assert(simulation.get_front_pressure(2).size() == 2, "front pressure follows active direction count")
	_assert(simulation.get_front_pressure_summary(2).contains("north clear"), "front pressure summary marks clear fronts")
	var front_defense_report = simulation.get_front_defense_report(3)
	_assert(bool(front_defense_report.get("ok", false)), "front defense report is available")
	_assert(simulation.get_front_defense_summary(3).contains("west needs setup"), "front defense summary is available")
	_assert(str(front_defense_report.get("weakest_direction", "")) == "west", "front defense starts with first uncovered active front")
	_assert(front_defense_report.get("priority_directions", []).size() == 3, "front defense priority follows active fronts")
	var recommendation_report = simulation.get_front_recommendation_tiles(3, "tower")
	_assert(bool(recommendation_report.get("ok", false)), "front recommendation report is available")
	_assert(str(recommendation_report.get("primary_direction", "")) == "west", "front recommendation follows weakest front")
	_assert(int(recommendation_report.get("candidate_count", 0)) > 0, "front recommendation returns valid candidate tiles")
	_assert(simulation.get_front_recommendation_summary(3, "tower").contains("west"), "front recommendation summary names target front")
	var recommendation_tiles: Dictionary = recommendation_report.get("tiles", {})
	var first_recommendation: Dictionary = {}
	for recommendation_value in recommendation_tiles.values():
		if typeof(recommendation_value) == TYPE_DICTIONARY:
			first_recommendation = recommendation_value
			break
	_assert(str(first_recommendation.get("why", "")).contains("west"), "front recommendation explains target front")
	_assert(first_recommendation.get("details", []).size() > 0, "front recommendation includes details")
	var autoplay_runner = M0AutoplayRunnerScript.new()
	var autoplay_candidates = autoplay_runner.debug_candidate_tiles_for_card(simulation, 3, "guardian", "m0_tower_permit")
	_assert(autoplay_candidates.size() > 0, "autoplay returns structure tile candidates")
	var has_recommendation_candidate = false
	for autoplay_candidate in autoplay_candidates:
		if typeof(autoplay_candidate) != TYPE_VECTOR2I:
			continue

		var candidate_tile: Vector2i = autoplay_candidate
		if recommendation_tiles.has("%s,%s" % [candidate_tile.x, candidate_tile.y]):
			has_recommendation_candidate = true
			break
	_assert(has_recommendation_candidate, "autoplay structure candidates include front recommendation")
	var front_defense_simulation = M0CombatSimulationScript.new()
	_assert(front_defense_simulation.load_data(), "front defense test data loads")
	_assert(bool(front_defense_simulation.debug_place_structure(Vector2i(15, 10), "tower")["ok"]), "front defense east tower can be placed")
	var east_defense_report = front_defense_simulation.get_front_defense_report(3)
	var east_front_defense: Dictionary = east_defense_report.get("by_direction", {}).get("east", {})
	_assert(int(east_front_defense.get("structure_count", 0)) == 1, "front defense counts structures near each front")
	_assert(str(east_defense_report.get("weakest_direction", "")) == "west", "front defense skips covered east front")
	_assert(bool(front_defense_simulation.debug_place_structure(Vector2i(2, 10), "barricade")["ok"]), "front defense west barricade can be placed")
	var north_gap_report = front_defense_simulation.get_front_defense_report(3)
	_assert(str(north_gap_report.get("weakest_direction", "")) == "north", "front defense rotates to the remaining uncovered front")
	_assert(str(north_gap_report.get("summary", "")).contains("north needs setup"), "front defense summary names uncovered fronts")
	var north_recommendation_report = front_defense_simulation.get_front_recommendation_tiles(3, "barricade")
	_assert(str(north_recommendation_report.get("primary_direction", "")) == "north", "front recommendation rotates with remaining uncovered front")
	var urgent_front_simulation = M0CombatSimulationScript.new()
	_assert(urgent_front_simulation.load_data(), "urgent front test data loads")
	_assert(bool(urgent_front_simulation.debug_place_structure(Vector2i(15, 10), "tower")["ok"]), "urgent front east tower can be placed")
	_assert(bool(urgent_front_simulation.debug_spawn_enemy(Vector2i(12, 10), 1, "east", "m0_colossus")["ok"]), "urgent front boss leak enemy can be spawned")
	urgent_front_simulation.debug_run_enemy_movement()
	var urgent_defense_report = urgent_front_simulation.get_front_defense_report(3)
	_assert(str(urgent_defense_report.get("weakest_direction", "")) == "east", "front defense prioritizes leaking boss front")
	var urgent_recommendation_report = urgent_front_simulation.get_front_recommendation_tiles(3, "barricade", "architect")
	var urgent_recommendation_tiles: Dictionary = urgent_recommendation_report.get("tiles", {})
	var urgent_autoplay_candidates = autoplay_runner.debug_candidate_tiles_for_card(urgent_front_simulation, 3, "architect", "m0_barricade_kit")
	_assert(urgent_autoplay_candidates.size() > 0, "urgent autoplay returns structure candidates")
	var urgent_first_candidate: Vector2i = urgent_autoplay_candidates[0]
	_assert(
		urgent_recommendation_tiles.has("%s,%s" % [urgent_first_candidate.x, urgent_first_candidate.y]),
		"urgent autoplay structure candidates lead with front recommendation"
	)
	var duo_urgent_simulation = M0CombatSimulationScript.new()
	_assert(duo_urgent_simulation.load_data(), "duo urgent front test data loads")
	_assert(bool(duo_urgent_simulation.debug_place_structure(Vector2i(15, 10), "tower")["ok"]), "duo urgent front east tower can be placed")
	_assert(bool(duo_urgent_simulation.debug_spawn_enemy(Vector2i(12, 10), 1, "east", "m0_colossus")["ok"]), "duo urgent front boss leak enemy can be spawned")
	duo_urgent_simulation.debug_run_enemy_movement()
	var duo_urgent_recommendation_report = duo_urgent_simulation.get_front_recommendation_tiles(2, "barricade", "elementalist")
	var duo_urgent_recommendation_tiles: Dictionary = duo_urgent_recommendation_report.get("tiles", {})
	var duo_urgent_autoplay_candidates = autoplay_runner.debug_candidate_tiles_for_card(duo_urgent_simulation, 2, "elementalist", "m0_barricade_kit")
	_assert(duo_urgent_autoplay_candidates.size() > 0, "duo urgent autoplay returns structure candidates")
	var duo_urgent_first_candidate: Vector2i = duo_urgent_autoplay_candidates[0]
	_assert(
		duo_urgent_recommendation_tiles.has("%s,%s" % [duo_urgent_first_candidate.x, duo_urgent_first_candidate.y]),
		"duo urgent autoplay structure candidates lead with front recommendation"
	)
	_assert(simulation.describe_wave(1, 10).contains("boss m0_colossus"), "boss wave is described on round 10")
	var colossus_data = simulation.get_enemy_data("m0_colossus")
	var colossus_parts: Array = colossus_data.get("bossParts", [])
	_assert(colossus_parts.size() == 3, "boss part data is loaded")
	_assert(simulation.get_enemy_trait_summary("m0_colossus").contains("Parts 3"), "boss trait summary includes part count")
	_assert(simulation.get_enemy_mix_summary(1) == "Walker", "round one enemy mix starts simple")
	_assert(simulation.get_enemy_mix_summary(2).contains("Skitter"), "round two enemy mix adds skitters")
	_assert(simulation.get_enemy_mix_summary(3).contains("Breaker"), "round three enemy mix adds breakers")
	_assert(simulation.get_enemy_mix_summary(4).contains("Bulwark"), "round four enemy mix adds bulwarks")
	_assert(int(simulation.get_enemy_data("m0_skitter").get("hp", 0)) == 4, "skitter enemy data is loaded")
	_assert(int(simulation.get_enemy_data("m0_skitter").get("moveSteps", 0)) == 2, "skitter fast move data is loaded")
	_assert(int(simulation.get_enemy_data("m0_breaker").get("structureDamage", 0)) == 7, "breaker pressure data is loaded")
	_assert(bool(simulation.get_enemy_data("m0_breaker").get("structurePriority", false)), "breaker priority data is loaded")
	_assert(int(simulation.get_enemy_data("m0_bulwark").get("hp", 0)) == 12, "bulwark enemy data is loaded")
	_assert(int(simulation.get_enemy_data("m0_bulwark").get("damageReduction", 0)) == 1, "bulwark armor data is loaded")
	_assert(simulation.get_enemy_trait_summary("m0_skitter").contains("Fast"), "enemy trait summary marks fast enemies")
	_assert(simulation.get_enemy_mix_trait_summary(4).contains("Armor"), "enemy mix trait summary marks armored enemies")
	_assert(simulation.get_autoplay_class_ids() == ["guardian", "architect", "elementalist", "tinkerer"], "autoplay class order is loaded")
	_assert(simulation.get_class_label("guardian") == "Guardian", "guardian class label is loaded")
	_assert(str(simulation.get_class_autoplay_profile("architect").get("tilePlan", "")) == "maze_grid", "architect autoplay plan is loaded")
	_assert(int(simulation.get_class_effects("guardian").get("thornsDamage", 0)) == 1, "guardian effect data is loaded")
	_assert(int(simulation.get_class_effects("guardian").get("tauntPriority", 0)) == 100, "guardian taunt priority data is loaded")
	_assert(int(simulation.get_class_effects("architect").get("barricadeDeathDamage", 0)) == 6, "architect effect data is loaded")
	_assert(int(simulation.get_class_effects("elementalist").get("cardBossDamageBonus", 0)) == 2, "elementalist boss spell effect data is loaded")
	var setup_report = simulation.get_run_setup_report(3, "elementalist")
	_assert(bool(setup_report.get("ok", false)), "run setup report accepts a valid setup")
	_assert(int(setup_report.get("player_count", 0)) == 3, "run setup report stores player count")
	_assert(str(setup_report.get("class_label", "")) == "Elementalist", "run setup report stores lead class")
	_assert(int(setup_report.get("seed_mana", 0)) == 8, "run setup report stores scaled seed mana")
	_assert(str(setup_report.get("summary", "")).contains("west, north, east"), "run setup report summarizes active fronts")
	_assert(str(setup_report.get("front_defense_summary", "")).contains("west needs setup"), "run setup report includes front defense status")
	_assert(simulation.get_run_setup_summary(1, "guardian").contains("Guardian"), "run setup summary includes selected class")
	var missing_setup_report = simulation.get_run_setup_report(2, "missing_class")
	_assert(str(missing_setup_report.get("reason", "")) == "unknown_class", "run setup rejects unknown class")
	_assert(str(simulation.get_card_data("m0_arc_spark").get("kind", "")) == "damage_enemy", "damage card data is loaded")
	_assert(str(simulation.get_card_data("m0_field_patch").get("kind", "")) == "repair_structure", "repair card data is loaded")
	_assert(str(simulation.get_card_data("m0_quick_think").get("kind", "")) == "draw_cards", "draw card data is loaded")
	_assert(simulation.get_card_role("m0_arc_spark") == "Damage", "damage card reward role is described")
	_assert(simulation.get_card_effect_summary("m0_field_patch").contains("Repair 4"), "repair card reward effect is described")
	_assert(simulation.get_card_deck_count("m0_tower_permit") == 2, "starting deck count is reported")
	_assert(simulation.get_card_rarity("m0_arc_spark") == "common", "card rarity is loaded")
	_assert(simulation.get_card_rarity_label("m0_heavy_bolt") == "Rare", "rare card rarity label is described")
	_assert(simulation.get_card_reward_min_round("m0_heavy_bolt") == 5, "rare card reward unlock round is loaded")
	_assert(simulation.get_reward_card_pool(1).has("m0_arc_spark"), "round one reward pool includes common cards")
	_assert(not simulation.get_reward_card_pool(1).has("m0_heavy_bolt"), "round one reward pool locks rare cards")
	_assert(simulation.get_reward_card_pool(5).has("m0_heavy_bolt"), "round five reward pool unlocks rare cards")
	_assert(simulation.get_reward_card_pool_summary(5).contains("rare=2"), "reward pool summary counts rare cards")
	var card_reward_report = simulation.get_card_reward_report("m0_arc_spark")
	_assert(bool(card_reward_report.get("ok", false)), "card reward report is available")
	_assert(str(card_reward_report.get("role", "")) == "Damage", "card reward report includes role")
	_assert(str(card_reward_report.get("effect", "")).contains("Deal 2"), "card reward report includes effect")
	_assert(str(card_reward_report.get("rarity_label", "")) == "Common", "card reward report includes rarity")
	var rare_reward_report = simulation.get_card_reward_report("m0_heavy_bolt")
	_assert(str(rare_reward_report.get("rarity_label", "")) == "Rare", "rare reward report includes rarity")
	_assert(str(rare_reward_report.get("unlock", "")) == "R5+", "rare reward report includes unlock")
	_assert(not bool(rare_reward_report.get("reward_unlocked", true)), "rare reward report marks locked early rewards")
	var reward_choice_runner = M0AutoplayRunnerScript.new()
	var reward_choice_simulation = M0CombatSimulationScript.new()
	_assert(reward_choice_simulation.load_data(), "reward choice test data loads")
	_assert(reward_choice_simulation.debug_generate_reward_offer(1).has("m0_arc_spark"), "round one debug reward offers damage coverage")
	var reward_recommendation = reward_choice_simulation.get_reward_recommendation_report(1, "guardian")
	_assert(bool(reward_recommendation.get("ok", false)), "reward recommendation is available")
	_assert(str(reward_recommendation.get("card_id", "")) == "m0_arc_spark", "reward recommendation fills missing damage coverage")
	_assert(str(reward_recommendation.get("reason_text", "")).contains("damage coverage"), "reward recommendation explains damage coverage")
	_assert(str(reward_recommendation.get("detail_text", "")).contains("Fronts: 1 active"), "reward recommendation detail names active fronts")
	_assert(str(reward_recommendation.get("detail_text", "")).contains("Deck:"), "reward recommendation detail includes deck context")
	_assert(str(reward_recommendation.get("detail_text", "")).contains("Gold option:"), "reward recommendation detail compares the gold choice")
	_assert(reward_choice_simulation.get_reward_offer_summary(1, "guardian").contains("Suggested"), "reward offer summary includes recommendation")
	_assert(reward_choice_simulation.get_reward_offer_summary(1, "guardian").contains("take +2 gold"), "reward offer summary includes the gold choice")
	_assert(
		reward_choice_runner.debug_choose_reward_card(reward_choice_simulation, "guardian") == "m0_arc_spark",
		"autoplay reward choice fills missing damage coverage"
	)
	_assert(bool(reward_choice_simulation.claim_reward_card("m0_arc_spark").get("ok", false)), "damage coverage reward can be claimed")
	var reward_gold_simulation = M0CombatSimulationScript.new()
	_assert(reward_gold_simulation.load_data(), "reward gold choice test data loads")
	_assert(reward_gold_simulation.debug_generate_reward_offer(1).size() == 3, "reward gold choice has card candidates")
	var reward_gold_gate_before: Dictionary = reward_gold_simulation.get_reward_to_maintenance_gate_report()
	_assert(str(reward_gold_gate_before.get("state", "")) == "blocked", "reward maintenance gate blocks pending reward choice")
	_assert(reward_gold_gate_before.get("pendingRewardChoiceLockIds", []).size() == 1, "reward maintenance gate tracks pending reward choice lock")
	_assert(not bool(reward_gold_gate_before.get("canStartPaidShopVote", true)), "reward maintenance gate blocks paid shop while reward is pending")
	_assert(str(reward_gold_gate_before.get("nextScreenType", "")) == "wave_preview", "reward maintenance gate points to wave preview after normal reward")
	_assert(reward_gold_gate_before.get("forbiddenGateTags", []).has("paidShopBeforeRewardResolved"), "reward maintenance gate forbids early paid shop")
	var reward_gold_before = reward_gold_simulation.get_gold()
	var reward_gold_result = reward_gold_simulation.skip_reward_offer()
	_assert(bool(reward_gold_result.get("ok", false)), "card reward can be taken as gold")
	_assert(str(reward_gold_result.get("reason", "")) == "reward_gold_taken", "reward gold choice reports its result")
	_assert(int(reward_gold_result.get("gold_gain", 0)) == reward_gold_simulation.get_card_reward_gold(), "reward gold choice returns configured gold")
	var reward_gold_lock: Dictionary = reward_gold_result.get("rewardChoiceLock", {})
	_assert(str(reward_gold_lock.get("choiceType", "")) == "decline_for_gold", "reward gold choice lock records decline choice")
	_assert(reward_gold_lock.has("chosenCardId") and reward_gold_lock.get("chosenCardId") == null, "reward gold choice lock leaves chosen card empty")
	_assert(int(reward_gold_lock.get("declineGoldAdded", 0)) == reward_gold_simulation.get_card_reward_gold(), "reward gold choice lock stores configured gold")
	_assert(str(reward_gold_lock.get("rewardPacketId", "")).contains("wave_reward_packet_day_001"), "reward gold choice lock stores reward packet id")
	_assert(str(reward_gold_lock.get("settlementBatchId", "")).contains("settlement_batch_day_001"), "reward gold choice lock stores settlement batch id")
	_assert(reward_gold_lock.get("forbiddenLockTags", []).has("partyCoercion"), "reward gold choice lock forbids party coercion")
	var reward_gold_lock_event: Dictionary = reward_gold_result.get("settlement_packet_choice_locked", {})
	_assert(str(reward_gold_lock_event.get("event", "")) == "settlement_packet_choice_locked", "reward gold choice exposes choice locked telemetry")
	_assert(reward_gold_simulation.get_gold() == reward_gold_before + reward_gold_simulation.get_card_reward_gold(), "reward gold choice increases gold")
	_assert(reward_gold_simulation.get_reward_offer().is_empty(), "reward gold choice clears card candidates")
	_assert(reward_gold_simulation.get_last_reward_claim_summary().contains("last gold choice"), "reward gold choice remains visible as last reward")
	_assert(str(reward_gold_result.get("economy_summary", "")).contains("shop trim gold 2/6 need 4"), "reward gold choice reports shop trim progress")
	_assert(reward_gold_simulation.get_card_reward_gold_choice_summary().contains("deck stays"), "reward gold choice explains deck size tradeoff")
	var reward_gold_gate_after: Dictionary = reward_gold_simulation.get_reward_to_maintenance_gate_report()
	_assert(str(reward_gold_gate_after.get("state", "")) == "clear", "reward maintenance gate clears after gold choice")
	_assert(reward_gold_gate_after.get("pendingRewardChoiceLockIds", []).is_empty(), "reward maintenance gate clears pending choice locks")
	_assert(bool(reward_gold_gate_after.get("canStartPaidShopVote", false)), "reward maintenance gate allows paid shop after reward choice")
	var reward_gold_stats = reward_gold_simulation.get_run_stats()
	_assert(int(reward_gold_stats.get("card_reward_gold_choices", 0)) == 1, "reward gold choice stat is tracked")
	_assert(int(reward_gold_stats.get("card_reward_gold_gained", 0)) == reward_gold_simulation.get_card_reward_gold(), "reward gold gain stat is tracked")
	var stable_gold_recommendation_simulation = M0CombatSimulationScript.new()
	_assert(stable_gold_recommendation_simulation.load_data(), "stable reward gold recommendation data loads")
	_assert(bool(stable_gold_recommendation_simulation.debug_set_hand([
		"m0_arc_spark",
		"m0_field_patch",
		"m0_quick_think",
		"m0_tower_permit",
		"m0_barricade_kit",
	]).get("ok", false)), "stable reward gold recommendation hand can be arranged")
	_assert(bool(stable_gold_recommendation_simulation.debug_set_draw_pile([
		"m0_arc_spark",
		"m0_tower_permit",
		"m0_barricade_kit",
		"m0_quick_brace",
	]).get("ok", false)), "stable reward gold recommendation draw pile can be arranged")
	_assert(bool(stable_gold_recommendation_simulation.debug_set_gold(
		stable_gold_recommendation_simulation.get_shop_deck_removal_gold_cost() - stable_gold_recommendation_simulation.get_card_reward_gold()
	).get("ok", false)), "stable reward gold recommendation gold can be set near shop trim")
	_assert(stable_gold_recommendation_simulation.debug_generate_reward_offer(5).size() == 3, "stable reward gold recommendation has card candidates")
	var stable_gold_recommendation = stable_gold_recommendation_simulation.get_reward_recommendation_report(1, "tinkerer")
	_assert(str(stable_gold_recommendation.get("choice_type", "")) == "gold", "reward recommendation can suggest gold when the deck is stable")
	_assert(str(stable_gold_recommendation.get("label", "")).contains("Take gold"), "reward gold recommendation labels the gold choice")
	_assert(str(stable_gold_recommendation.get("reason_text", "")).contains("shop trim"), "reward gold recommendation explains shop trim timing")
	_assert(str(stable_gold_recommendation.get("detail_text", "")).contains("Coverage:"), "reward gold recommendation detail includes coverage context")
	_assert(str(stable_gold_recommendation.get("detail_text", "")).contains("shop trim 6/6 ready"), "reward gold recommendation detail shows ready shop trim")
	_assert(reward_choice_simulation.debug_generate_reward_offer(5).has("m0_heavy_bolt"), "round five debug reward offers heavy damage")
	var heavy_reward_recommendation = reward_choice_simulation.get_reward_recommendation_report(1, "guardian")
	_assert(str(heavy_reward_recommendation.get("card_id", "")) == "m0_heavy_bolt", "reward recommendation adds heavy damage after first damage pick")
	_assert(str(heavy_reward_recommendation.get("detail_text", "")).contains("copies 0 -> 1"), "reward recommendation detail shows copy change")
	_assert(
		reward_choice_runner.debug_choose_reward_card(reward_choice_simulation, "guardian") == "m0_heavy_bolt",
		"autoplay reward choice adds heavy boss damage coverage"
	)
	var multi_damage_reward_simulation = M0CombatSimulationScript.new()
	_assert(multi_damage_reward_simulation.load_data(), "multi damage reward test data loads")
	_assert(multi_damage_reward_simulation.debug_generate_reward_offer(1).has("m0_arc_spark"), "multi damage reward offers first damage card")
	_assert(bool(multi_damage_reward_simulation.claim_reward_card("m0_arc_spark").get("ok", false)), "multi damage reward first damage can be claimed")
	_assert(multi_damage_reward_simulation.debug_generate_reward_offer(5).has("m0_heavy_bolt"), "multi damage reward offers heavy damage")
	_assert(bool(multi_damage_reward_simulation.claim_reward_card("m0_heavy_bolt").get("ok", false)), "multi damage reward heavy damage can be claimed")
	_assert(multi_damage_reward_simulation.debug_generate_reward_offer(9).has("m0_arc_spark"), "multi damage reward offers repeat damage")
	_assert(
		reward_choice_runner.debug_choose_reward_card(multi_damage_reward_simulation, "architect", 4) == "m0_arc_spark",
		"autoplay reward choice scales damage coverage for multi-front runs"
	)
	_assert(str(simulation.get_artifact_data("m0_deep_pockets").get("label", "")) == "Deep Pockets", "artifact data is loaded")
	var seed_core_effects: Dictionary = simulation.get_artifact_data("m0_seed_core").get("effects", {})
	_assert(int(seed_core_effects.get("seedManaBonus", 0)) == 1, "artifact effect data is loaded")
	_assert(simulation.get_artifact_effect_summary("m0_deep_pockets").contains("Max hand +1"), "artifact effect summary describes hand bonus")
