func _run_card_effect_tests() -> void:
	var damage_simulation = M0CombatSimulationScript.new()
	_assert(damage_simulation.load_data(), "damage card test data loads")
	_assert(bool(damage_simulation.debug_set_hand(["m0_arc_spark"])["ok"]), "damage card test hand is set")
	_assert(bool(damage_simulation.debug_spawn_enemy(Vector2i(18, 10), 6)["ok"]), "damage card target enemy is spawned")
	var damage_preview = damage_simulation.can_play_card_at_tile("m0_arc_spark", Vector2i(18, 10), 1)
	_assert(bool(damage_preview["ok"]), "damage card can target enemy tile")
	var damage_play = damage_simulation.play_card_at_tile("m0_arc_spark", Vector2i(18, 10), 1)
	_assert(bool(damage_play["ok"]), "damage card can be played")
	var damage_stats = damage_simulation.get_run_stats()
	var damaged_enemies = damage_simulation.debug_get_enemies()
	var damaged_enemy_hp = -1
	if not damaged_enemies.is_empty():
		damaged_enemy_hp = int(damaged_enemies[0].get("hp", -1))
	_assert(damaged_enemy_hp == 4, "damage card reduces enemy hp")
	_assert(int(damage_stats.get("card_damage_dealt", 0)) == 2, "damage card stat is tracked")
	_assert(damage_simulation.get_mana() == 3, "damage card spends mana")

	var boss_spell_simulation = M0CombatSimulationScript.new()
	_assert(boss_spell_simulation.load_data(), "boss spell damage test data loads")
	_assert(bool(boss_spell_simulation.debug_set_hand(["m0_arc_spark"])["ok"]), "boss spell damage test hand is set")
	_assert(bool(boss_spell_simulation.debug_spawn_enemy(Vector2i(18, 10), 30, "east", "m0_colossus")["ok"]), "boss spell damage target can be spawned")
	var boss_spell_focus = boss_spell_simulation.get_boss_focus_part_report(Vector2i(18, 10))
	_assert(bool(boss_spell_focus.get("ok", false)), "boss spell target exposes focus part")
	_assert(str(boss_spell_focus.get("label", "")) == "Legs", "boss spell focus starts at legs")
	_assert(str(boss_spell_focus.get("summary", "")).contains("Legs 4/4"), "boss spell focus summary includes part hp")
	var boss_spell_preview = boss_spell_simulation.can_play_card_at_tile("m0_arc_spark", Vector2i(18, 10), 1, "elementalist")
	_assert(str(boss_spell_preview.get("boss_part_label", "")) == "Legs", "boss spell preview includes boss part label")
	var boss_spell_target_tiles: Dictionary = boss_spell_simulation.get_card_target_tiles("m0_arc_spark", 1, "elementalist").get("tiles", {})
	var boss_spell_target_tile: Dictionary = boss_spell_target_tiles.get("18,10", {})
	_assert(str(boss_spell_target_tile.get("boss_part_label", "")) == "Legs", "boss spell target tiles include boss part label")
	var boss_spell_play = boss_spell_simulation.play_card_at_tile("m0_arc_spark", Vector2i(18, 10), 1, "elementalist")
	_assert(bool(boss_spell_play["ok"]), "elementalist boss spell damage card can be played")
	var boss_spell_stats = boss_spell_simulation.get_run_stats()
	var boss_spell_enemies = boss_spell_simulation.debug_get_enemies()
	var boss_spell_hp = -1
	if not boss_spell_enemies.is_empty():
		boss_spell_hp = int(boss_spell_enemies[0].get("hp", -1))
	_assert(boss_spell_hp == 26, "elementalist damage card gains boss bonus")
	_assert(int(boss_spell_stats.get("card_damage_dealt", 0)) == 4, "elementalist boss bonus is tracked as card damage")
	_assert(int(boss_spell_stats.get("boss_part_damage", 0)) == 4, "boss part damage is tracked")
	_assert(int(boss_spell_stats.get("boss_parts_destroyed", 0)) == 1, "boss part destruction is tracked")
	var boss_spell_part_reports = boss_spell_simulation.get_boss_part_reports()
	_assert(bool(boss_spell_part_reports[0].get("destroyed", false)), "elementalist boss spell breaks the leg part")
	_assert(boss_spell_simulation.get_boss_focus_part_summary(Vector2i(18, 10)).contains("Front 5/5"), "boss spell focus moves to front after legs break")
	_assert(boss_spell_simulation.get_run_stats_summary().contains("parts=1/4/0"), "run stats summary includes boss part totals")

	var repair_simulation = M0CombatSimulationScript.new()
	_assert(repair_simulation.load_data(), "repair card test data loads")
	_assert(bool(repair_simulation.place_structure(Vector2i(18, 10), "tower", 1)["ok"]), "repair card test tower is placed")
	_assert(bool(repair_simulation.debug_spawn_enemy(Vector2i(19, 10), 6)["ok"]), "repair card test enemy is spawned")
	repair_simulation.debug_run_enemy_movement()
	_assert(bool(repair_simulation.debug_set_hand(["m0_field_patch"])["ok"]), "repair card test hand is set")
	var repair_preview = repair_simulation.can_play_card_at_tile("m0_field_patch", Vector2i(18, 10), 1)
	_assert(bool(repair_preview["ok"]), "repair card can target damaged structure")
	var repair_play = repair_simulation.play_card_at_tile("m0_field_patch", Vector2i(18, 10), 1)
	_assert(bool(repair_play["ok"]), "repair card can be played")
	var repair_stats = repair_simulation.get_run_stats()
	var repaired_structure: Dictionary = repair_simulation.get_structure_tiles().get("18,10", {})
	_assert(int(repaired_structure.get("hp", 0)) == 12, "repair card restores structure hp")
	_assert(int(repair_stats.get("card_repairs", 0)) == 4, "repair card stat is tracked")

	var draw_simulation = M0CombatSimulationScript.new()
	_assert(draw_simulation.load_data(), "draw card test data loads")
	_assert(bool(draw_simulation.debug_set_hand(["m0_quick_think"])["ok"]), "draw card test hand is set")
	_assert(bool(draw_simulation.debug_set_draw_pile(["m0_tower_permit"])["ok"]), "draw card test draw pile is set")
	var draw_preview = draw_simulation.can_play_card("m0_quick_think")
	_assert(bool(draw_preview["ok"]), "draw card can be played without tile")
	var draw_play = draw_simulation.play_card("m0_quick_think")
	_assert(bool(draw_play["ok"]), "draw card play succeeds")
	var draw_stats = draw_simulation.get_run_stats()
	var draw_hand = draw_simulation.get_hand()
	_assert(draw_hand.size() == 1 and str(draw_hand[0]) == "m0_tower_permit", "draw card draws from draw pile")
	_assert(int(draw_stats.get("card_effect_draws", 0)) == 1, "draw card stat is tracked")

	var kill_draw_simulation = M0CombatSimulationScript.new()
	_assert(kill_draw_simulation.load_data(), "kill draw report test data loads")
	_assert(bool(kill_draw_simulation.debug_set_hand([])["ok"]), "kill draw report hand can be emptied")
	_assert(bool(kill_draw_simulation.debug_set_draw_pile(["m0_tower_permit"])["ok"]), "kill draw report pile can be arranged")
	_assert(bool(kill_draw_simulation.debug_place_structure(Vector2i(15, 10), "tower")["ok"]), "kill draw report tower can be placed")
	_assert(bool(kill_draw_simulation.debug_spawn_enemy(Vector2i(18, 10), 1, "east", "m0_walker")["ok"]), "kill draw report first enemy can be spawned")
	_assert(bool(kill_draw_simulation.debug_spawn_enemy(Vector2i(17, 9), 1, "east", "m0_walker")["ok"]), "kill draw report second enemy can be spawned")
	kill_draw_simulation.debug_run_tower_attack()
	kill_draw_simulation.debug_run_tower_attack()
	var kill_draw_report = kill_draw_simulation.get_last_kill_resource_report()
	_assert(bool(kill_draw_report.get("ok", false)), "last kill resource report is stored after a kill")
	_assert(int(kill_draw_report.get("mana_gain", 0)) == kill_draw_simulation.get_mana_per_kill(), "last kill resource report tracks mana gain")
	_assert(int(kill_draw_report.get("gold_gain", 0)) == kill_draw_simulation.get_gold_per_kill(), "last kill resource report tracks gold gain")
	_assert(int(kill_draw_report.get("draw_gauge_gain", 0)) == kill_draw_simulation.get_draw_gauge_per_kill(), "last kill resource report tracks draw gauge gain")
	_assert(int(kill_draw_report.get("drawn_count", 0)) == 1, "last kill resource report tracks reward draw")
	_assert(str(kill_draw_report.get("summary", "")).contains("drew Tower Permit"), "last kill resource summary names the drawn card")
	_assert(kill_draw_simulation.get_last_kill_resource_summary().contains("Combat gains"), "last kill resource summary is visible")
	_assert(kill_draw_simulation.get_hand().has("m0_tower_permit"), "kill reward draw adds the drawn card to hand")
	var kill_draw_pressure = kill_draw_simulation.get_hand_pressure_report()
	_assert(str(kill_draw_pressure.get("state", "")) == "open", "hand pressure stays open after a successful reward draw with room")
	_assert(kill_draw_simulation.get_hand_pressure_summary().contains("Hand pressure"), "hand pressure summary is visible")

	var near_full_simulation = M0CombatSimulationScript.new()
	_assert(near_full_simulation.load_data(), "near-full hand pressure test data loads")
	_assert(bool(near_full_simulation.debug_set_hand([
		"m0_tower_permit",
		"m0_barricade_kit",
		"m0_arc_spark",
		"m0_field_patch",
	])["ok"]), "near-full hand pressure hand can be arranged")
	_assert(bool(near_full_simulation.debug_set_draw_pile(["m0_tower_permit"])["ok"]), "near-full hand pressure pile can be arranged")
	_assert(bool(near_full_simulation.debug_place_structure(Vector2i(15, 10), "tower")["ok"]), "near-full hand pressure tower can be placed")
	_assert(bool(near_full_simulation.debug_spawn_enemy(Vector2i(18, 10), 1, "east", "m0_walker")["ok"]), "near-full hand pressure enemy can be spawned")
	near_full_simulation.debug_run_tower_attack()
	var near_full_pressure = near_full_simulation.get_hand_pressure_report()
	_assert(str(near_full_pressure.get("state", "")) == "near_full", "hand pressure warns when the next kill may draw into one slot")
	_assert(near_full_simulation.get_hand_pressure_summary().contains("next kill may draw"), "near-full hand pressure summary explains the next-kill draw risk")

	var kill_held_simulation = M0CombatSimulationScript.new()
	_assert(kill_held_simulation.load_data(), "kill held report test data loads")
	_assert(bool(kill_held_simulation.debug_set_draw_pile(["m0_tower_permit"])["ok"]), "kill held report pile can be arranged")
	_assert(bool(kill_held_simulation.debug_place_structure(Vector2i(15, 10), "tower")["ok"]), "kill held report tower can be placed")
	_assert(bool(kill_held_simulation.debug_spawn_enemy(Vector2i(18, 10), 1, "east", "m0_walker")["ok"]), "kill held report first enemy can be spawned")
	_assert(bool(kill_held_simulation.debug_spawn_enemy(Vector2i(17, 9), 1, "east", "m0_walker")["ok"]), "kill held report second enemy can be spawned")
	kill_held_simulation.debug_run_tower_attack()
	kill_held_simulation.debug_run_tower_attack()
	var kill_held_report = kill_held_simulation.get_last_kill_resource_report()
	_assert(str(kill_held_report.get("draw_held_reason", "")) == "hand_full", "last kill resource report tracks held reward draw reason")
	_assert(int(kill_held_report.get("drawn_count", 0)) == 0, "held kill reward draw does not draw a card")
	_assert(kill_held_simulation.get_draw_gauge() == kill_held_simulation.get_draw_gauge_per_card(), "held reward draw keeps the full draw gauge")
	_assert(kill_held_simulation.get_last_kill_resource_summary().contains("draw held"), "last kill resource summary explains held draw")
	var kill_held_pressure = kill_held_simulation.get_hand_pressure_report()
	_assert(str(kill_held_pressure.get("state", "")) == "draw_held", "hand pressure escalates after a reward draw is held")
	_assert(kill_held_simulation.get_hand_pressure_summary().contains("draw held because hand is full"), "hand pressure summary explains full-hand reward draw hold")


func _events_contain(events: Array, fragment: String) -> bool:
	for event in events:
		if str(event).contains(fragment):
			return true
	return false


func _assert(condition: bool, label: String) -> void:
	if condition:
		print("[PASS] %s" % label)
	else:
		failed = true
		push_error("[FAIL] %s" % label)
