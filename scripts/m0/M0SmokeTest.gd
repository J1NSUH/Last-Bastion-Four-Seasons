	_assert(str(wave_started_report.get("previewCardId", "")).contains("001"), "wave start result links the preview card")
	_assert(str(wave_started_report.get("spawnPlanId", "")) == "spawn_plan_day_001", "wave start result links the spawn plan")
	var started_spawn_plan: Dictionary = wave_started_report.get("spawnPlan", {})
	_assert(int(started_spawn_plan.get("spawnPacketCount", 0)) > 0, "wave start result carries spawn packets")
	var started_preview_card: Dictionary = wave_started_report.get("previewCard", {})
	_assert(started_preview_card.get("directions", []) == ["east"], "wave start preview card matches actual spawn directions")
	_assert(str(started_preview_card.get("spawnPlanId", "")) == "spawn_plan_day_001", "wave start preview card stores spawn plan")
	_assert(wave_result.get("directions", []) == ["east"], "wave result exposes actual spawn directions")
	_assert(str(wave_result.get("spawnPlanId", "")) == "spawn_plan_day_001", "wave result exposes the spawn plan id")
	_assert(str(wave_result.get("previewCardId", "")).contains("001"), "wave result exposes the preview card id")
	_assert(str(simulation.can_start_wave(1).get("reason", "")) == "wave_already_active", "wave readiness blocks active waves")
	_assert(simulation.get_active_round() == 1, "active wave tracks round 1")
	_assert(simulation.get_mana() == 4, "round start refills seed mana")
	_assert(simulation.get_discard_charges() == 1, "round start refills discard charge")
	_assert(simulation.get_next_wave_preview_summary(1).contains("R2"), "active wave preview points at the next callable wave")

	var active_wave_card_id = str(simulation.get_hand()[0])
	var active_wave_card_result = simulation.play_card_at_tile(active_wave_card_id, Vector2i(17, 9), 1)
	_assert(bool(active_wave_card_result["ok"]), "card can be played during an active wave")

	var saw_spawn = false
	var saw_attack_or_base_damage = false
	var saw_end = false
	var saw_event_tiles = false
	var saw_kill_reward = false

	for _index in range(80):
		var events = simulation.step_wave(1)
		if not simulation.get_recent_event_tiles().is_empty():
			saw_event_tiles = true
		for event in events:
			if event.contains("spawned"):
				saw_spawn = true
			if event.contains("hit") or event.contains("reached base"):
				saw_attack_or_base_damage = true
			if event.contains("Wave complete") or event.contains("Wave group complete") or event.contains("Base destroyed"):
				saw_end = true
			if event.contains("Kill reward"):
				saw_kill_reward = true

		if not simulation.wave_active:
			break

	_assert(saw_spawn, "wave spawns enemies")
	_assert(saw_attack_or_base_damage, "wave produces combat or base damage")
	_assert(saw_event_tiles, "wave exposes recent event tiles")
	_assert(saw_kill_reward, "kills grant resource rewards")
	_assert(saw_end, "wave reaches an end state")
	_assert(simulation.get_completed_rounds() == 1, "round completion is tracked")
	var last_round_report = simulation.get_last_round_report()
	_assert(bool(last_round_report.get("ok", false)), "last round report is available after wave completion")
	_assert(str(last_round_report.get("round_label", "")).contains("round 1"), "last round report stores completed round")
	_assert(int(last_round_report.get("spawned", 0)) > 0, "last round report counts spawned enemies")
	_assert(int(last_round_report.get("reward_packets_queued", 0)) >= 1, "last round report tracks queued rewards")
	_assert(simulation.get_last_round_summary().contains("Last round 1"), "last round summary names the completed round")
	var last_round_panel_report = simulation.get_last_round_panel_report(1)
	_assert(bool(last_round_panel_report.get("ok", false)), "last round panel report is available")
	_assert(str(last_round_panel_report.get("title", "")).contains("round 1"), "last round panel title names the completed round")
	_assert(str(last_round_panel_report.get("score_line", "")).begins_with("Score:"), "last round panel has a score section")
	_assert(str(last_round_panel_report.get("problem_line", "")).begins_with("Problem:"), "last round panel has a problem section")
	_assert(str(last_round_panel_report.get("next_action_line", "")).begins_with("Next action:"), "last round panel has a next action section")
	_assert(str(last_round_panel_report.get("reward_line", "")).contains("Reward waiting"), "last round panel reports pending reward")
	_assert(str(last_round_panel_report.get("rewards_line", "")).begins_with("Rewards:"), "last round panel has a rewards section")
	_assert(str(last_round_panel_report.get("next_line", "")).contains("R2"), "last round panel previews next wave")
	_assert(str(last_round_panel_report.get("preview_line", "")).begins_with("Upcoming:"), "last round panel has an upcoming section")
	_assert(simulation.get_last_round_panel_summary(1).contains("Round"), "last round panel summary is formatted")
	_assert(simulation.get_current_round() == 2, "next round is prepared")
	_assert(simulation.get_reward_offer().size() == 3, "wave completion offers card rewards")
	_assert(simulation.get_reward_offer().has("m0_arc_spark"), "rotating rewards can offer effect cards")
	_assert(simulation.get_reward_offer_reports().size() == 3, "reward offer reports match offered cards")
	_assert(simulation.get_reward_offer_summary().contains("choose 1"), "reward offer summary explains the choice")
	_assert(simulation.get_maintenance_check_summary().contains("resolve card reward"), "maintenance check points to pending card reward")
	var reward_preview = simulation.get_card_reward_report(str(simulation.get_reward_offer()[0]))
	_assert(str(reward_preview.get("claim_preview", "")).contains("discard"), "reward preview explains claim destination")
	_assert(str(reward_preview.get("deck_zone_summary", "")).contains("discard"), "reward preview includes card zone summary")

	var blocked_wave_result = simulation.start_wave(1)
	_assert(str(blocked_wave_result["reason"]) == "reward_pending", "pending reward blocks next wave")
	_assert(str(simulation.can_start_wave(1).get("reason", "")) == "reward_pending", "wave readiness reports pending reward block")

	var reward_card_id = str(simulation.get_reward_offer()[0])
	var discard_count_before_reward = simulation.get_discard_count()
	var claim_reward_result = simulation.claim_reward_card(reward_card_id)
	_assert(bool(claim_reward_result["ok"]), "reward card can be claimed")
	_assert(str(claim_reward_result.get("effect", "")).length() > 0, "claimed reward returns effect summary")
	_assert(
		int(claim_reward_result.get("deck_count_after", 0)) == int(claim_reward_result.get("deck_count_before", 0)) + 1,
		"claimed reward reports the new deck count"
	)
	_assert(str(claim_reward_result.get("destination", "")) == "discard", "claimed reward reports destination pile")
	_assert(str(claim_reward_result.get("deck_after_summary", "")).contains("Deck"), "claimed reward reports full deck summary")
	var reward_choice_lock: Dictionary = claim_reward_result.get("rewardChoiceLock", {})
	_assert(str(reward_choice_lock.get("choiceType", "")) == "card", "claimed reward choice lock records card choice")
	_assert(str(reward_choice_lock.get("chosenCardId", "")) == reward_card_id, "claimed reward choice lock stores chosen card")
	_assert(int(reward_choice_lock.get("declineGoldAdded", -1)) == 0, "claimed reward choice lock stores zero decline gold")
	_assert(str(reward_choice_lock.get("rewardPacketId", "")).contains("wave_reward_packet_day_001"), "claimed reward choice lock stores reward packet id")
	_assert(str(reward_choice_lock.get("settlementBatchId", "")).contains("settlement_batch_day_001"), "claimed reward choice lock stores settlement batch id")
	_assert(str(reward_choice_lock.get("reversalDeadline", "")) == "before_first_paid_shop_vote", "claimed reward choice lock stores reversal deadline")
	_assert(not bool(reward_choice_lock.get("isTemporary", true)), "claimed reward choice lock is final")
	_assert(bool(reward_choice_lock.get("noBonusRewards", false)), "claimed reward choice lock records no bonus rewards")
	_assert(reward_choice_lock.get("forbiddenLockTags", []).has("forcedCurse"), "claimed reward choice lock forbids forced curse")
	var choice_locked_event: Dictionary = claim_reward_result.get("settlement_packet_choice_locked", {})
	_assert(str(choice_locked_event.get("event", "")) == "settlement_packet_choice_locked", "claimed reward exposes choice locked telemetry")
	_assert(str(choice_locked_event.get("choiceType", "")) == "card", "claimed reward choice locked telemetry records card choice")
	var last_reward_claim_report = simulation.get_last_reward_claim_report()
	_assert(bool(last_reward_claim_report.get("ok", false)), "last reward claim report is stored")
	_assert(str(last_reward_claim_report.get("card_id", "")) == reward_card_id, "last reward claim report stores card id")
	_assert(str(last_reward_claim_report.get("rewardChoiceLockId", "")) == str(reward_choice_lock.get("id", "")), "last reward claim report stores choice lock id")
	_assert(simulation.get_last_reward_claim_summary().contains("last pick"), "last reward claim summary is visible")
	_assert(simulation.get_reward_offer().is_empty(), "reward offer clears after claim")
	_assert(simulation.get_reward_offer_summary().contains("last pick"), "empty reward area shows last claimed reward")
	_assert(simulation.get_discard_count() == discard_count_before_reward + 1, "claimed reward enters discard pile")
	_assert(bool(simulation.can_start_wave(1).get("ok", false)), "wave readiness recovers after reward claim")
	_assert(simulation.get_maintenance_check_summary().contains("Maintenance: clear"), "maintenance check clears after reward claim")

	var next_wave_result = simulation.start_wave(1)
	_assert(bool(next_wave_result["ok"]), "next wave starts after reward claim")
	_assert(simulation.get_active_round() == 2, "second wave tracks round 2")
	_assert(simulation.get_mana() == 4, "next round refills seed mana")
	_assert(simulation.get_discard_charges() == 1, "next round refills discard charge")

	var stats = simulation.get_run_stats()
	_assert(int(stats.get("spawned", 0)) > 0, "stats count spawned enemies")
	_assert(int(stats.get("steps", 0)) > 0, "stats count wave steps")
	_assert(int(stats.get("cards_drawn", 0)) >= 5, "stats count card draws")
	_assert(int(stats.get("cards_played", 0)) == 3, "stats count played cards")
	_assert(int(stats.get("mana_spent", 0)) == 4, "stats count spent mana")
	_assert(int(stats.get("cards_discarded", 0)) == 1, "stats count discarded cards")
	_assert(int(stats.get("discard_mana_gained", 0)) == 1, "stats count discard mana")
	_assert(int(stats.get("card_rewards_offered", 0)) == 3, "stats count offered reward cards")
	_assert(int(stats.get("card_rewards_taken", 0)) == 1, "stats count claimed reward cards")
	_assert(int(stats.get("rounds_started", 0)) == 2, "stats count started rounds")
	_assert(int(stats.get("rounds_completed", 0)) == 1, "stats count completed rounds")
	_assert(int(stats.get("round_mana_refills", 0)) == 2, "stats count round mana refills")
	_assert(int(stats.get("discard_refills", 0)) == 2, "stats count discard refills")
	_assert(int(stats.get("kill_mana_gained", 0)) > 0, "stats count kill mana rewards")
	_assert(int(stats.get("gold_gained", 0)) > 0, "stats count kill gold rewards")
	_assert(int(stats.get("draw_gauge_gained", 0)) > 0, "stats count draw gauge rewards")
	_assert(
		int(stats.get("tower_hits", 0)) > 0 or int(stats.get("base_hits", 0)) > 0,
		"stats count combat consequences"
	)

	quit(1 if failed else 0)


